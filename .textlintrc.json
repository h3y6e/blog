{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "/\\+\\+\\+[\\s\\S]*?\\+\\+\\+/m",
        "/\\$\\$[\\s\\S]*?\\$\\$/m",
        "/\\$.+?\\$/",
        "/{.+?}/",
        "/気が[しす]/",
        "\\"
      ]
    }
  },
  "rules": {
    "@blog/preset-style": {
      "marker-repetition": {
        "severity": "warning",
        "markers": ["良い", "と思う", "面白い", "ちなみに", "便利", "最高", "嬉しい", "いい感じ"]
      },
      "self-copy": {
        "severity": "warning",
        "allow": ["AdventCalendar", "CAMPHOR-の運営メンバー"]
      }
    },
    "prh": {
      "checkEmphasis": true,
      "checkHeader": true,
      "rulePaths": ["./.prh.yml"]
    },
    "preset-ja-spacing": {
      "ja-space-between-half-and-full-width": {
        "lintStyledNode": true
      },
      "ja-space-around-code": {
        "before": true,
        "after": true
      },
      "ja-space-around-link": false,
      "ja-no-space-around-slash": false
    },
    "preset-ja-technical-writing": {
      "ja-no-weak-phrase": false,
      "no-exclamation-question-mark": false,
      "no-mix-dearu-desumasu": false,
      "ja-no-mixed-period": false,
      "sentence-length": {
        "max": 150,
        "skipPatterns": ["/（.*?）。$/"]
      },
      "ja-no-redundant-expression": {
        "dictOptions": {
          "dict5": {
            "allows": [
              "/^通信を行[ぁ-ん]/",
              "/^[ァ-ヶ]+を.?行[ぁ-ん]/",
              "/^[a-zA-Z]+を.?行[ぁ-ん]/"
            ]
          }
        }
      },
      "max-kanji-continuous-len": {
        "max": 6,
        "allow": ["主小行列固有値", "平均単位取得率", "宇宙産業従事者"]
      },
      "max-ten": {
        "touten": ["、", "，", ","],
        "kuten": ["。", "．", "."]
      }
    },
    "@textlint-ja/no-synonyms": {
      "allows": ["足", "リプ", "まとめ", "ネット", "ポケモン"]
    },
    "@textlint-ja/preset-ai-writing": {
      "no-ai-hype-expressions": {
        "disableAbsolutenessPatterns": true
      },
      "ai-tech-writing-guideline": {
        "disableRedundancyGuidance": true,
        "disableClarityGuidance": true,
        "disableConsistencyGuidance": true,
        "disableStructureGuidance": true,
        "enableDocumentAnalysis": true
      }
    }
  }
}
